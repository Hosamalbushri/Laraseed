{
    "name": "webkul/lost-and-found",
    "description": "Lost and Found domain module for CampusHub",
    "license": "MIT",
    "authors": [
        {
            "name": "Webkul",
            "email": "example@webkul.com"
        }
    ],
    "require": {
        "krayin/laravel-admin": "^1.0",
        "krayin/laravel-core": "^1.0",
        "krayin/laravel-datagrid": "^1.0",
        "krayin/laravel-user": "^1.0",
        "webkul/student": "dev-main"
    },
    "autoload": {
        "psr-4": {
            "Webkul\\LostAndFound\\": "src/"
        }
    },
    "extra": {
        "campushub": {
            "id": "lost_and_found",
            "type": "optional",
            "provider": "Webkul\\LostAndFound\\Providers\\LostAndFoundServiceProvider",
            "concord_module": "Webkul\\LostAndFound\\Providers\\ModuleServiceProvider"
        }
    },
    "minimum-stability": "dev"
}
