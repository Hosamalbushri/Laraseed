{
    "name": "webkul/student",
    "description": "Student authentication via university API for Krayin CRM",
    "license": "MIT",
    "authors": [
        {
            "name": "Webkul"
        }
    ],
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.8",
        "krayin/laravel-admin": "^1.0",
        "krayin/laravel-core": "^1.0",
        "krayin/laravel-datagrid": "^1.0",
        "laravel/framework": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Webkul\\Student\\": "src/"
        }
    },
    "extra": {
        "campushub": {
            "id": "student",
            "type": "optional",
            "provider": "Webkul\\Student\\Providers\\StudentServiceProvider",
            "concord_module": null
        }
    },
    "minimum-stability": "dev"
}
