{
    "name": "webkul/website",
    "description": "Optional site-specific presentation package for CampusHub",
    "license": "MIT",
    "authors": [
        {
            "name": "Webkul"
        }
    ],
    "require": {
        "php": "^8.3",
        "webkul/core": "*",
        "webkul/web": "*",
        "webkul/theme": "*"
    },
    "autoload": {
        "psr-4": {
            "Webkul\\Website\\": "src/"
        }
    },
    "extra": {
        "campushub": {
            "id": "website",
            "type": "optional",
            "provider": "Webkul\\Website\\Providers\\WebsiteServiceProvider",
            "concord_module": null,
            "requires": []
        }
    },
    "minimum-stability": "dev"
}
